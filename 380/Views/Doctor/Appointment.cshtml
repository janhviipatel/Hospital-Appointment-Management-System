<!DOCTYPE html>
<html>

<head>
    <title>Patient Appointment</title>
</head>

<body>

    <h1>Patient Appointment Form</h1>

    <form method="post"
          action="/Doctor/Appointment">

        <!-- Hidden field contains DoctorId -->
        <input type="hidden"
               name="doctorId"
               value="@ViewBag.DoctorId" />

        <br />

        <label>Patient Name:</label>

        <input type="text"
               name="patientName"
               required />

        <br /><br />

        <button type="submit">
            Book Appointment
        </button>

    </form>

</body>

</html>