@model List<_380.Controllers.Post>

@{
    ViewData["Title"] = "Posts";
}

<div class="container">

    <h1>Posts from JSONPlaceholder</h1>

    <hr />

    <h2 style="text-align:center;">
        API Posts
    </h2>

    <table>

        <thead>

            <tr>
                <th>Post ID</th>
                <th>Title</th>
            </tr>

        </thead>

        <tbody>

            @foreach (var post in Model)
            {
                <tr>

                    <td>
                        @post.Id
                    </td>

                    <td style="text-align:left;">
                        @post.Title
                    </td>

                </tr>
            }

        </tbody>

    </table>

    <div class="page-links">

        <a href="/Doctor/Index">
            ← Back to Doctors
        </a>

    </div>

</div>